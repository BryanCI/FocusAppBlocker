<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AppBlocker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Theme.AppBlocker.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.AppBlocker.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/focussapp</item>
        <item name="postSplashScreenTheme">@style/Theme.AppBlocker</item>
    </style>

    <style name="Widget.App.BottomNavigationView.ActiveIndicator" parent="">
        <item name="android:color">#D000FF</item>
        <item name="android:width">80dp</item>
        <item name="android:height">40dp</item>
        <item name="marginHorizontal">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="NavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">92dp</item>
        <item name="android:height">44dp</item>
        <item name="android:color">@color/neon_magenta</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NavPill</item>
    </style>

    <style name="ShapeAppearance.NavPill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="NavTextActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="NavTextInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#9E9E9E</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="LuxuryAlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurface">#161616</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorPrimary">#BF00FF</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="QuickBlockChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_quick_block_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/quick_block_text_selector</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
    </style>

    <style name="CircleIconContainer">
        <item name="android:background">@drawable/bg_circle_pink</item>
    </style>

    <style name="ChipDark" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_dark_bg_selector</item>
        <item name="android:textColor">@color/chip_dark_text_selector</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>