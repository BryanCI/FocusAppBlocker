<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/bg_premium"
        android:padding="24dp">

        <!-- LOGO + ORBITING ICONS CONTAINER -->
        <FrameLayout
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp">

            <!-- CENTER LOGO -->
            <ImageView
                android:id="@+id/ivLogoCenter"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:src="@drawable/focussapp"
                android:contentDescription="FocusApp Logo" />

            <!-- ORBITING ICONS -->
            <ImageView android:id="@+id/iconMessages" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_message_purple" android:layout_gravity="top|start" android:layout_marginStart="20dp" android:layout_marginTop="40dp"/>
            <ImageView android:id="@+id/iconInstagram" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_instagram_purple" android:layout_gravity="top|end" android:layout_marginEnd="20dp" android:layout_marginTop="40dp"/>
            <ImageView android:id="@+id/iconWhatsapp" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_whatsapp_purple" android:layout_gravity="center_vertical|end" android:layout_marginEnd="0dp"/>
            <ImageView android:id="@+id/iconTelegram" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_telegram_purple" android:layout_gravity="bottom|end" android:layout_marginEnd="20dp" android:layout_marginBottom="40dp"/>
            <ImageView android:id="@+id/iconLaptop" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_laptop_purple" android:layout_gravity="bottom|start" android:layout_marginStart="20dp" android:layout_marginBottom="40dp"/>
            <ImageView android:id="@+id/iconPhone" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_phone_purple" android:layout_gravity="center_vertical|start" android:layout_marginStart="0dp"/>

        </FrameLayout>

        <!-- HEADLINE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time to take back your"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="life"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"/>

        <!-- SUBTEXT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/take_back_life_subtext"
            android:textColor="@color/text_secondary_premium"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginBottom="40dp"/>

        <!-- BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueScreen2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_purple"
            app:cornerRadius="16dp"
            app:strokeColor="#30BF00FF"
            app:strokeWidth="1dp"
            android:elevation="0dp"
            android:translationZ="0dp" />

    </LinearLayout>
</ScrollView>