<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_premium"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- PROGRESS BAR -->
        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progress="25"
            android:max="100"
            android:progressTint="@color/neon_magenta"
            android:layout_marginBottom="40dp"/>

        <!-- LOGO -->
        <ImageView
            android:id="@+id/ivLogoScreen2"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginBottom="32dp"
            android:src="@drawable/focussapp"
            android:contentDescription="FocusApp Logo"
            android:scaleType="fitCenter"/>

        <!-- HEADLINE -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time to take back your\nlife"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"/>

        <!-- SUBTEXT -->
        <TextView
            android:id="@+id/tvSubtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/take_back_life_subtext"
            android:textColor="@color/textSecondary"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginBottom="40dp"/>

        <!-- BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueScreen2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/neon_magenta"
            app:cornerRadius="16dp"
            app:strokeColor="#30BF00FF"
            app:strokeWidth="1dp"
            android:textColor="@color/white"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>