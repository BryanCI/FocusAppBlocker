<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scheduleCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="116dp"
    app:cardCornerRadius="28dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="1dp"
    app:strokeColor="#3A3A50"
    android:layout_marginBottom="18dp"
    app:cardElevation="0dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <View
            android:id="@+id/activeOuterGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="-12dp"
            android:background="@drawable/bg_active_outer_glow"
            android:alpha="0.0" />

        <View
            android:id="@+id/activeBorderGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_active_border_purple"
            android:alpha="0.0" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_ultra"
            android:paddingBottom="22dp"
            android:minHeight="110dp">

            <View
                android:id="@+id/glassLine"
                android:layout_width="match_parent"
                android:layout_height="1.2dp"
                android:background="#FFFFFF"
                android:alpha="0.14"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/leftGlow"
                android:layout_width="16dp"
                android:layout_height="94dp"
                android:background="#B440FF"
                android:alpha="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="0dp" />

            <View
                android:id="@+id/leftBar"
                android:layout_width="6dp"
                android:layout_height="88dp"
                android:background="#0A84FF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="4dp" />

            <FrameLayout
                android:id="@+id/iconContainer"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_icon_oval"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:id="@+id/iconGlow"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_glow_purple_oval"
                    android:alpha="0.0" />
                <TextView
                    android:id="@+id/iconEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="30sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="normal"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="16dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintStart_toEndOf="@id/iconContainer"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/controls" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#9A9AAF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintStart_toEndOf="@id/iconContainer"
                app:layout_constraintTop_toBottomOf="@id/title"
                app:layout_constraintEnd_toStartOf="@id/controls" />

            <TextView
                android:id="@+id/timeChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_ultra"
                android:textColor="#E9D5FF"
                android:textSize="12sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:maxLines="1"
                android:minWidth="110dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toEndOf="@id/iconContainer"
                app:layout_constraintTop_toBottomOf="@id/subtitle" />

            <LinearLayout
                android:id="@+id/controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/editIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_icon_oval_small"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#9A9AAF"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="12dp" />

                <ImageView
                    android:id="@+id/closeIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_icon_oval_small"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#6E6E7A"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="12dp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/activeBadgeContainer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge_scheduled_grey"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintStart_toEndOf="@id/iconContainer"
                app:layout_constraintTop_toBottomOf="@id/timeChip">

                <LinearLayout
                    android:id="@+id/scheduledLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_glow_green_oval" />

                    <TextView
                        android:id="@+id/scheduledBadgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCHEDULED"
                        android:textColor="#9A9AA0"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/activeLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center">
                        <View
                            android:id="@+id/activeDotOuter"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_glow_green_oval"
                            android:alpha="0.28" />
                        <View
                            android:id="@+id/activeDot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_dot_green_bright"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/activeCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE 01:11:58"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </FrameLayout>

            <View
                android:id="@+id/activeProgressGlow"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_progress_glow_purple"
                android:alpha="0.16"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/activeProgress"
                app:layout_constraintBottom_toBottomOf="@id/activeProgress"
                app:layout_constraintStart_toStartOf="@id/activeProgress"
                app:layout_constraintEnd_toEndOf="@id/activeProgress" />

            <View
                android:id="@+id/activeProgress"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:background="#2A2A38"
                android:visibility="gone"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:id="@+id/activeProgressFill"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_progress_fill_dual"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/activeProgress"
                app:layout_constraintStart_toStartOf="@id/activeProgress" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>