<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20.dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Schedule"
            android:textColor="#BF00FF"
            android:textSize="22.sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutConflict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.dp"
            android:background="@drawable/bg_conflict_banner"
            android:gravity="center_vertical"
            android:padding="12.dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20.dp"
                android:layout_height="20.dp"
                android:src="@android:drawable/stat_sys_warning"
                app:tint="#FFCC00" />

            <TextView
                android:id="@+id/tvConflictMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8.dp"
                android:textColor="#FFCC00"
                android:textSize="13.sp"
                tools:text="Conflict detected with 'Study Time'" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.dp"
            app:boxStrokeColor="#2A2A2A"
            app:hintTextColor="#8A8A8A">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScheduleName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Schedule Name"
                android:textColor="@android:color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Days Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.dp"
            android:gravity="center"
            android:orientation="horizontal">
            <!-- 7 day circles -->
            <CheckBox android:id="@+id/dayMon" android:layout_width="40dp" android:layout_height="40dp" android:button="@null" android:background="@drawable/chip_day_selector" android:gravity="center" android:text="M" android:textColor="@android:color/white" android:layout_margin="4dp"/>
            <CheckBox android:id="@+id/dayTue" android:layout_width="40dp" android:layout_height="40dp" android:button="@null" android:background="@drawable/chip_day_selector" android:gravity="center" android:text="T" android:textColor="@android:color/white" android:layout_margin="4dp"/>
            <CheckBox android:id="@+id/dayWed" android:layout_width="40dp" android:layout_height="40dp" android:button="@null" android:background="@drawable/chip_day_selector" android:gravity="center" android:text="W" android:textColor="@android:color/white" android:layout_margin="4dp"/>
            <CheckBox android:id="@+id/dayThu" android:layout_width="40dp" android:layout_height="40dp" android:button="@null" android:background="@drawable/chip_day_selector" android:gravity="center" android:text="T" android:textColor="@android:color/white" android:layout_margin="4dp"/>
            <CheckBox android:id="@+id/dayFri" android:layout_width="40dp" android:layout_height="40dp" android:button="@null" android:background="@drawable/chip_day_selector" android:gravity="center" android:text="F" android:textColor="@android:color/white" android:layout_margin="4dp"/>
            <CheckBox android:id="@+id/daySat" android:layout_width="40dp" android:layout_height="40dp" android:button="@null" android:background="@drawable/chip_day_selector" android:gravity="center" android:text="S" android:textColor="@android:color/white" android:layout_margin="4dp"/>
            <CheckBox android:id="@+id/daySun" android:layout_width="40dp" android:layout_height="40dp" android:button="@null" android:background="@drawable/chip_day_selector" android:gravity="center" android:text="S" android:textColor="@android:color/white" android:layout_margin="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnStartTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6.dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/ic_menu_recent_history" app:tint="#BF00FF"/>
                    <TextView android:id="@+id/tvStartTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="07:00" android:textColor="@android:color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnEndTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6.dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/ic_menu_recent_history" app:tint="#BF00FF"/>
                    <TextView android:id="@+id/tvEndTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="08:00" android:textColor="@android:color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectApps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#252525"
            android:text="Select Apps"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_add"
            app:iconTint="#BF00FF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchStrictMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Strict Mode (No editing while active)"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="#8A8A8A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:backgroundTint="#BF00FF"
                android:text="Save Schedule"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="16dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
