<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_premium"
    android:padding="24.dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0.dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="64.dp"
        android:text="How FocusAppBlock works"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/timeline_bar"
        android:layout_width="4dp"
        android:layout_height="0.dp"
        android:layout_marginStart="8.dp"
        android:layout_marginTop="32.dp"
        android:background="@color/neon_magenta"
        app:layout_constraintBottom_toBottomOf="@id/item3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintTop_toTopOf="@id/item1" />

    <LinearLayout
        android:id="@+id/item1"
        android:layout_width="0.dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24.dp"
        android:layout_marginTop="40.dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/timeline_bar"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="@color/neon_magenta"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.dp"
            android:text="Set up block schedules and start your first focus session"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item2"
        android:layout_width="0.dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24.dp"
        android:layout_marginTop="48.dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/timeline_bar"
        app:layout_constraintTop_toBottomOf="@id/item1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Day 3"
            android:textColor="@color/neon_magenta"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.dp"
            android:text="Get insights on your screen time and most distracting apps"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item3"
        android:layout_width="0.dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24.dp"
        android:layout_marginTop="48.dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/timeline_bar"
        app:layout_constraintTop_toBottomOf="@id/item2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Day 7"
            android:textColor="@color/neon_magenta"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.dp"
            android:text="Build a streak and unlock Premium features"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32.dp"
        android:text="Free to start. Upgrade anytime for unlimited schedules."
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/layout_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32.dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_skip"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="56.dp"
            android:layout_weight="1"
            android:text="Skip"
            android:textAllCaps="false"
            android:textColor="#AAAAAA"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_get_started"
            android:layout_width="0dp"
            android:layout_height="56.dp"
            android:layout_marginStart="16.dp"
            android:layout_weight="2"
            android:backgroundTint="@color/neon_magenta"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>