<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_luxury"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_pill_dark"
        android:backgroundTint="@color/divider_grey" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Developer Menu"
        android:textColor="@color/white"
        android:textSize="24sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="sans-serif-medium"
        android:text="Manual triggers for workers and data testing"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTriggerMorningSummary"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:text="Trigger Morning Summary Worker"
        android:textAlignment="viewStart"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_bell" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTriggerStreakReminder"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:text="Trigger Streak Reminder Worker"
        android:textAlignment="viewStart"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_bell" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetStats"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:text="Reset Today's Stats"
        android:textAlignment="viewStart"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_chart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTogglePremium"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Toggle Premium Status"
        android:textAlignment="viewStart"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_star" />

</LinearLayout>