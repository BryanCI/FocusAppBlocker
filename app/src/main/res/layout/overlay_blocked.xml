<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_purple"
            android:text="F"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Channels blocked"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#B24CFF"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvBlockedAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You chose to block Channels.\nStatus is still allowed."
            android:textSize="15sp"
            android:textColor="#8A8A8E"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvUnblockTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#A78BFA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="12dp"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/tvFrictionTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Breathe in..."
            android:textColor="#B24CFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="visible"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal"/>

        <!-- BREATHING ANIMATION CIRCLE - One Sec style -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="48dp">

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_breathing_circle"/>

            <View
                android:id="@+id/breathingCircle"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_breathing_inner"/>

        </FrameLayout>

        <Button
            android:id="@+id/btnGoHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Wait 5s..."
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#6A6A6E"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="#2A2A30"
            android:enabled="false"
            android:alpha="0.5"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status is still available"
            android:textSize="11sp"
            android:textColor="#4A4A4E"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</FrameLayout>