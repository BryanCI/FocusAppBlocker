<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_purple"
            android:text="@string/overlay_icon_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#B24CFF"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvBlockedAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_subtitle"
            android:textSize="15sp"
            android:textColor="#8A8A8E"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_stay_focused"
            android:textSize="16sp"
            android:textColor="#E5E5E5"
            android:layout_marginBottom="48dp"/>

        <TextView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:text="@string/overlay_emoji"
            android:textSize="56sp"
            android:gravity="center"
            android:background="@drawable/bg_circle_dark"
            android:layout_marginBottom="48dp"/>

        <!-- FIXED: Use regular Button, NOT MaterialButton, works from Service on all phones -->
        <Button
            android:id="@+id/btnGoHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/overlay_btn_home"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="#2A2A30"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_footer"
            android:textSize="11sp"
            android:textColor="#4A4A4E"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</FrameLayout>