<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/focusShieldCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="32dp"
            app:strokeWidth="1dp"
            app:strokeColor="#35354A"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_ultra"
                android:padding="24dp"
                android:minHeight="260dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/topHighlight"
                    android:layout_width="match_parent"
                    android:layout_height="1.2dp"
                    android:background="#FFFFFF"
                    android:alpha="0.14" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/dateText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SATURDAY, SEP 5"
                            android:textColor="#9A9AAF"
                            android:textSize="11sp"
                            android:letterSpacing="0.14" />

                        <LinearLayout
                            android:id="@+id/scoreLiveContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:id="@+id/liveBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_badge_live_red"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:visibility="gone"
                                android:layout_marginEnd="8dp">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center">
                                    <FrameLayout
                                        android:layout_width="10dp"
                                        android:layout_height="10dp">
                                        <View
                                            android:id="@+id/liveDotOuter"
                                            android:layout_width="10dp"
                                            android:layout_height="10dp"
                                            android:background="@drawable/bg_dot_red"
                                            android:alpha="0.28" />
                                        <View
                                            android:id="@+id/liveDot"
                                            android:layout_width="6dp"
                                            android:layout_height="6dp"
                                            android:background="@drawable/bg_dot_red"
                                            android:layout_gravity="center" />
                                    </FrameLayout>
                                    <TextView
                                        android:id="@+id/liveText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="LIVE"
                                        android:textColor="@android:color/white"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:layout_marginStart="6dp" />
                                </LinearLayout>
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/scoreContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp">
                                <View
                                    android:id="@+id/scoreGlowOuter"
                                    android:layout_width="72dp"
                                    android:layout_height="42dp"
                                    android:background="@drawable/bg_glow_green_oval"
                                    android:alpha="0.24" />
                                <FrameLayout
                                    android:id="@+id/scorePill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_score_pill"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="14dp"
                                    android:layout_gravity="center">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:orientation="horizontal"
                                        android:gravity="center">
                                        <FrameLayout
                                            android:layout_width="14dp"
                                            android:layout_height="14dp">
                                            <View
                                                android:id="@+id/greenDotOuter"
                                                android:layout_width="14dp"
                                                android:layout_height="14dp"
                                                android:background="@drawable/bg_glow_green_oval"
                                                android:alpha="0.28" />
                                            <View
                                                android:id="@+id/greenDot"
                                                android:layout_width="9dp"
                                                android:layout_height="9dp"
                                                android:background="@drawable/bg_glow_green_oval"
                                                android:layout_gravity="center" />
                                        </FrameLayout>
                                        <TextView
                                            android:id="@+id/scoreText"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Score: 100"
                                            android:textColor="#4ADE80"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:layout_marginStart="8dp" />
                                    </LinearLayout>
                                </FrameLayout>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/focusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus Shield"
                        android:textColor="@android:color/white"
                        android:textSize="36sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.03"
                        android:layout_marginTop="22dp" />

                    <LinearLayout
                        android:id="@+id/activeInfoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/activeScheduleName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 Digital Sabbath"
                            android:textColor="#B440FF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:letterSpacing="0.01" />

                        <TextView
                            android:id="@+id/activeScheduleCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE 00:50:56 • until 23:59"
                            android:textColor="#4ADE80"
                            android:textSize="13sp"
                            android:textStyle="normal"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:letterSpacing="0.02" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/progressContainer"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="24dp"
                        android:clipChildren="false">
                        <View
                            android:id="@+id/progressGlow"
                            android:layout_width="match_parent"
                            android:layout_height="16dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/bg_progress_fill_dual"
                            android:alpha="0.32" />
                        <View
                            android:id="@+id/progressTrack"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/bg_progress_track_ultra" />
                        <View
                            android:id="@+id/progressFill"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/bg_progress_fill_dual" />
                        <View
                            android:id="@+id/shimmerView"
                            android:layout_width="90dp"
                            android:layout_height="6dp"
                            android:layout_gravity="center_vertical"
                            android:background="@android:color/white"
                            android:alpha="0.0" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/statsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="18dp"
                        android:weightSum="3">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6h" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Focused" android:textColor="#8E8E93" android:textSize="11sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Breaks" android:textColor="#8E8E93" android:textSize="11sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4d" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Streak" android:textColor="#8E8E93" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/moonTimeline"
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:layout_marginTop="22dp">
                        <FrameLayout
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <View
                                android:id="@+id/moonOuterGlow"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="@drawable/bg_glow_yellow_oval"
                                android:alpha="0.26" />
                            <View
                                android:id="@+id/moonInnerGlow"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_glow_yellow_oval"
                                android:alpha="0.20" />
                            <TextView
                                android:id="@+id/moonIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🌙"
                                android:textSize="26sp" />
                        </FrameLayout>
                        <View
                            android:id="@+id/trackLine"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="#2E2E3A"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginBottom="30dp" />
                        <LinearLayout
                            android:id="@+id/ticksContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginBottom="26dp">
                            <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:background="#4A4A5A" />
                            <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:background="#4A4A5A" />
                            <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:background="#4A4A5A" />
                            <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:background="#4A4A5A" />
                            <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:background="#4A4A5A" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/labelsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textColor="#7A7A8A" android:textSize="11sp" android:gravity="center" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="06:00" android:textColor="#7A7A8A" android:textSize="11sp" android:gravity="center" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="12:00" android:textColor="#7A7A8A" android:textSize="11sp" android:gravity="center" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="18:00" android:textColor="#7A7A8A" android:textSize="11sp" android:gravity="center" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textColor="#7A7A8A" android:textSize="11sp" android:gravity="center" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/createScheduleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="210dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="28dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3A3A50"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="26dp"
                android:background="@drawable/bg_card_ultra"
                android:clipChildren="false"
                android:clipToPadding="false">

                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:clipChildren="false">
                    <View
                        android:id="@+id/createGlow"
                        android:layout_width="124dp"
                        android:layout_height="124dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_glow_purple_oval"
                        android:alpha="0.28" />
                    <FrameLayout
                        android:id="@+id/createCircle"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_create_circle_oval"
                        android:clipChildren="false">
                        <TextView
                            android:id="@+id/calendarIcon"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:gravity="center"
                            android:text="🗓️"
                            android:textSize="32sp" />
                    </FrameLayout>
                </FrameLayout>

                <Button
                    android:id="@+id/createScheduleButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_create_button_dual"
                    android:text="+ Create Schedule"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/mySchedulesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Schedules"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginTop="32dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rules for focused internet use"
                android:textColor="#8E8E93"
                android:textSize="14sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:id="@+id/mySchedulesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:minHeight="60dp" />

            <LinearLayout
                android:id="@+id/layoutEmptyMySchedules"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_empty_premium"
                android:visibility="gone"
                android:elevation="0dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_purple_circle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✨"
                        android:textSize="18sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No active rules yet"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap a template to start ↓"
                        android:textColor="#8B8B95"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#A855F7"
                    android:alpha="0.6"
                    android:layout_marginEnd="4dp" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Templates"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick start with proven routines"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp" />

        <LinearLayout
            android:id="@+id/templatesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>