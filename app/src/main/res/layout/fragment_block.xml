<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:clipToPadding="false"
    android:fitsSystemWindows="false"
    android:paddingBottom="340dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="120dp"
        android:background="@android:color/transparent">

        <!-- Header -->
        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="start|center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_focus_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FocusAppBlock"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="56dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/ripple_rounded_12dp"
                android:backgroundTint="@color/bg_inner_opal"
                android:padding="11dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="8dp"
                app:tint="#FFFFFF"/>

            <ImageView
                android:id="@+id/settingsIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:src="@drawable/ic_settings"
                android:background="@drawable/ripple_rounded_12dp"
                android:backgroundTint="@color/bg_inner_opal"
                android:padding="11dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="8dp"
                app:tint="#FFFFFF"/>
        </FrameLayout>

        <!-- Premium "All Set" Health Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/system_status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1E1E"
            app:strokeWidth="2dp"
            app:strokeColor="#FFC107"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Card Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/healthHeaderIconContainer"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_icon"
                        android:backgroundTint="#242200">
                        <ImageView
                            android:id="@+id/ivHealthHeaderIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_warning_amber"
                            app:tint="#FACC15"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tvHealthTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System Status"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvHealthSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6 permissions needed"
                            android:textColor="#FACC15"
                            android:textSize="13sp"
                            android:layout_marginTop="1dp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFixNow"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Fix Now"
                        android:textColor="#FACC15"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="12dp"
                        app:cornerRadius="16dp"
                        android:backgroundTint="#242200"/>

                    <ImageView
                        android:id="@+id/ivHealthChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#4A4A4A"
                        android:visibility="gone"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPermissionRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Block Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card_opal"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_card_opal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_icon"
                        android:backgroundTint="@color/bg_icon_purple_opal">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bolt"
                            app:tint="@color/primary_purple"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quick Block"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start a focus session instantly"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Chips Grid -->
                <GridLayout
                    android:id="@+id/layoutIdle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:columnCount="4"
                    android:alignmentMode="alignMargins">

                    <TextView
                        android:id="@+id/btn15m"
                        style="@style/QuickBlockChip"
                        android:text="15m" />

                    <TextView
                        android:id="@+id/btn30m"
                        style="@style/QuickBlockChip"
                        android:text="30m" />

                    <TextView
                        android:id="@+id/btn1h"
                        style="@style/QuickBlockChip"
                        android:text="1h" />

                    <TextView
                        android:id="@+id/btn2h"
                        style="@style/QuickBlockChip"
                        android:text="2h" />

                    <TextView
                        android:id="@+id/btn4h"
                        style="@style/QuickBlockChip"
                        android:text="4h" />

                    <TextView
                        android:id="@+id/btn6h"
                        style="@style/QuickBlockChip"
                        android:text="6h" />

                    <TextView
                        android:id="@+id/btnCustom"
                        style="@style/QuickBlockChip"
                        android:text="Custom" />

                    <TextView
                        android:id="@+id/btnInf"
                        style="@style/QuickBlockChip"
                        android:background="@drawable/bg_chip_infinity"
                        android:textColor="@color/primary_purple"
                        android:textSize="18sp"
                        android:text="∞" />

                </GridLayout>

                <!-- Active State -->
                <LinearLayout
                    android:id="@+id/layoutActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="8dp">

                    <!-- Top row: pulsing dot + status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/dotPulse"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/premium_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FOCUS ACTIVE"
                            android:textColor="@color/primary_purple"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/textBlockingStatusTop"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="• Blocking 4 apps"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:gravity="end"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Big timer with progress ring -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressRing"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:layout_gravity="center"
                            app:indicatorSize="200dp"
                            app:trackThickness="10dp"
                            app:indicatorColor="@color/primary_purple"
                            app:trackColor="@color/bg_inner_opal"
                            app:trackCornerRadius="5dp"
                            android:progress="60" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_gravity="center">

                            <TextView
                                android:id="@+id/tvCountdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14:54"
                                android:textColor="#FFFFFF"
                                android:textSize="44sp"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="remaining"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="-4dp" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Blocked apps icons stack + names -->
                    <LinearLayout
                        android:id="@+id/layoutBlockedPreviewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <HorizontalScrollView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_gravity="center_horizontal">

                            <LinearLayout
                                android:id="@+id/layoutBlockedIcons"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:clipToPadding="false" />
                        </HorizontalScrollView>

                        <TextView
                            android:id="@+id/tvActiveSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blocking AI Gallery, Camera +2"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEndEarly"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="End Early"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="28dp"
                        android:backgroundTint="@color/premium_red"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_close"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Customize Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCustomizeApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card_opal"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_card_opal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/iconCustomize"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_icon"
                        android:backgroundTint="@color/bg_icon_purple_opal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tune"
                            app:tint="@color/primary_purple"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/iconCustomize"
                        app:layout_constraintEnd_toStartOf="@id/ivChevronCustomize"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Customize Blocking"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Configure apps, keywords, content blockers"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:ellipsize="none"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivChevronCustomize"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#4A4A4A"
                        android:alpha="0.6"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Strict Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStrictMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card_opal"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_card_opal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/iconStrictModeContainer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#2A1515">
                    <ImageView
                        android:id="@+id/ivStrictModeIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shield"
                        app:tint="#FF4B4B"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Strict Mode"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prevents disabling focus sessions early."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchStrictMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:useMaterialThemeColors="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
