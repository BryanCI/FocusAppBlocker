<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- SECTION 1: HERO LUXURY HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp">

                <FrameLayout
                    android:id="@+id/btnClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_close_luxury"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_close"
                        app:tint="#8A8A8E"
                        android:contentDescription="Close" />
                </FrameLayout>
            </RelativeLayout>

            <FrameLayout
                android:id="@+id/diamondContainer"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="20dp">

                <!-- Glow behind diamond -->
                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_glow_gold"
                    android:alpha="0.4"/>

                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_diamond_container_luxury" />

                <ImageView
                    android:id="@+id/ivDiamond"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_diamond"
                    app:tint="#FFD700"
                    android:contentDescription="Premium Diamond" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHeroTitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="32dp"
                android:gravity="center"
                android:text="Invest in your"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvHeroTitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Happiness and"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvHeroTitleSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Success!"
                android:textColor="#FFD700"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Social Proof Avatars -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="20dp">
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_circle_dark"
                        android:gravity="center"
                        android:text="JD"
                        android:textColor="#FFFFFF"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_circle_dark"
                        android:gravity="center"
                        android:text="AM"
                        android:textColor="#FFFFFF"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="24dp"
                        android:background="@drawable/bg_circle_dark"
                        android:gravity="center"
                        android:text="KT"
                        android:textColor="#FFFFFF"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Join 12,000+ focused minds"
                    android:textColor="#8A8A8E"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- SECTION 2: FEATURES PREMIUM CARD -->
            <LinearLayout
                android:id="@+id/featuresCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_luxury_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"
                    android:text="PREMIUM INCLUDES"
                    android:textColor="#BF00FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <!-- Feature Rows -->
                <include layout="@layout/item_premium_feature_luxury" android:id="@+id/feature1" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E1E1E" />
                <include layout="@layout/item_premium_feature_luxury" android:id="@+id/feature2" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E1E1E" />
                <include layout="@layout/item_premium_feature_luxury" android:id="@+id/feature3" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E1E1E" />
                <include layout="@layout/item_premium_feature_luxury" android:id="@+id/feature4" />

            </LinearLayout>

            <!-- SECTION 3: PRICING -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="CHOOSE YOUR PLAN"
                android:textColor="#BF00FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Card Monthly -->
            <LinearLayout
                android:id="@+id/layoutMonthly"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_luxury_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:id="@+id/radioMonthly"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_radio_unselected" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$1.00 / month"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Billed monthly"
                        android:textColor="#8A8A8E"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedMonthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected"
                    android:textColor="#BF00FF"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Card Yearly HERO -->
            <LinearLayout
                android:id="@+id/layoutAnnual"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_luxury_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <View
                    android:id="@+id/radioAnnual"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_radio_selected_gold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_gold"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="BEST VALUE"
                            android:textColor="#000000"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Save 5 months free"
                            android:textColor="#FFD700"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="$6.99 / year"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="That's less than $0.59/month"
                            android:textColor="#10B981"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvYearlyStrike"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="$12"
                            android:textColor="#6B7280"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedAnnual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- SECTION 4: CTA BUTTON -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="16dp">

                <Button
                    android:id="@+id/btnSubscribe"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_premium_luxury"
                    android:text="Continue • $6.99/year"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:backgroundTint="@null" />

                <ProgressBar
                    android:id="@+id/loadingSpinner"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="#10B981"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Cancel anytime. No commitment. • 3-day free trial"
                    android:textColor="#8A8A8E"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnRestore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Restore purchases"
                android:textColor="#8A8A8E"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Terms • Privacy"
                android:textColor="#4A4A4A"
                android:textSize="11sp" />

            <!-- SECTION 5: TRUST FOOTER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:text="Made with 💜 in Uganda • v38.1.0"
                android:textColor="#4A4A4A"
                android:textSize="10sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
