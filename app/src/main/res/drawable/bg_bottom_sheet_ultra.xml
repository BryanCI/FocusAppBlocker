<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="32dp" android:topRightRadius="32dp" />
            <gradient
                android:angle="270"
                android:endColor="#17171F"
                android:startColor="#2D2D42" />
            <stroke
                android:width="1dp"
                android:color="#3A3A50" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="32dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="32dp" android:topRightRadius="32dp" />
            <solid android:color="#17FFFFFF" />
        </shape>
    </item>
</layer-list>