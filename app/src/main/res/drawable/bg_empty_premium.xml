<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E1E26" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#2E2E3A" />
        </shape>
    </item>
    <!-- Left purple accent like Digital Sabbath red line -->
    <item
        android:left="0dp"
        android:right="316dp"
        android:top="14dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#A855F7" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>