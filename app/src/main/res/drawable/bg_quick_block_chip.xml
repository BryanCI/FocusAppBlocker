<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/bg_chip_selected" />
                    <stroke android:color="@color/stroke_chip_selected" android:width="1dp"/>
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/bg_chip_selected" />
                    <stroke android:color="@color/stroke_chip_selected" android:width="1dp"/>
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/bg_chip_unselected" />
                    <stroke android:color="@color/stroke_chip_unselected" android:width="1dp"/>
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>